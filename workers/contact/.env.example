# Cloudflare CLI auth for THIS project only (never commit real values).
# Copy to `.env` in this directory. Wrangler loads it automatically and prefers
# these over the global `wrangler login` OAuth token — required when Cursor
# works across multiple Cloudflare accounts (DermicIQ vs Forjyn, etc.).
#
# Create a token: Cloudflare Dashboard → My Profile → API Tokens
#   Template: "Edit Cloudflare Workers" (or custom with Workers Scripts Edit
#   + Account Settings Read + Zone read if you attach routes).
#
# Account ID: Dashboard → Workers & Pages → Overview (right sidebar).

CLOUDFLARE_ACCOUNT_ID=replace_with_dermiciq_account_id
CLOUDFLARE_API_TOKEN=replace_with_dermiciq_api_token
